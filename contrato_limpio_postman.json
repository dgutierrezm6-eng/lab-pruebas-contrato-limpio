  "item": [
    {
      "name": "crea contrato valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201 Creado', () => pm.response.to.have.status(201));\npm.test('Responde en menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));\nconst contrato = pm.response.json();\npm.test('Calcula valor total en 1000000', () => pm.expect(contrato.valor).to.eql(1000000));\npm.test('Estado inicial Activo (Fondeado)', () => pm.expect(contrato.estado).to.eql('Activo (Fondeado)'));\npm.collectionVariables.set('contratoId', contrato.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Desarrollo Pagina Web\",\n  \"creador\": \"danna@correo.com\",\n  \"contraparte\": \"cliente@empresa.co\",\n  \"hitos\": [\n    { \"titulo\": \"Prototipo UI\", \"monto\": 400000 },\n    { \"titulo\": \"Entrega Final\", \"monto\": 600000 }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:5001/contratos",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "5001",
          "path": [
            "contratos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Consultar el contrato, sus hitos y la custodia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200 OK', () => pm.response.to.have.status(200));\nconst detalle = pm.response.json();\npm.test('Guarda los 2 hitos atómicamente', () => pm.expect(detalle.hitos.length).to.eql(2));\npm.test('Fondos retenidos En Custodia', () => pm.expect(detalle.custodia.estado).to.eql('En Custodia'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5001/contratos/{{contratoId}}",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "5001",
          "path": [
            "contratos",
            "{{contratoId}}"
          ]
        }
      },
      "response": []
    },
